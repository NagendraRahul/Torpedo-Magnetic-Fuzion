    }
    Serial.println();

    Serial.print(F("CTRL: YAW="));
    Serial.print(control.yawCommand, 1);
    Serial.print(F(" PITCH="));
    Serial.print(control.pitchCommand, 1);
    Serial.print(F(" SERVOS: L="));
    Serial.print(control.left);
    Serial.print(F(" R="));
    Serial.print(control.right);
    Serial.print(F(" T="));
    Serial.print(control.top);
    Serial.print(F(" B="));
    Serial.println(control.bottom);

    Serial.print(F("PERF: LOOP="));
    Serial.print(performance.loopTime, 2);
    Serial.print(F("ms SENS="));
    Serial.print(performance.sensorTime, 2);
    Serial.print(F("ms DET_RATE="));
    Serial.print(performance.detectionRate, 1);
    Serial.print(F("% CYCLES="));
    Serial.println(performance.totalCycles);

    Serial.println(F("---"));
}

void handleSystemError() {
    Serial.print(F("SYSTEM ERROR: Code "));
    Serial.println(status.errorCode);

    analogWrite(MOTOR_PWM_PIN, 0);
    centerAllServos();

    for (int i = 0; i < status.errorCode; i++) {
        digitalWrite(ARMED_LED_PIN, HIGH);
        digitalWrite(DETECTION_LED_PIN, HIGH);
        delay(200);
        digitalWrite(ARMED_LED_PIN, LOW);
        digitalWrite(DETECTION_LED_PIN, LOW);
        delay(200);
    }

    delay(2000);

    if (status.errorCode < 5) {
        status.systemError = false;
        status.errorCode = 0;
        Serial.println(F("Attempting recovery..."));
    }
}

void emergencyDisarm() {
    status.armed = false;
    status.targetLocked = false;
    digitalWrite(ARMED_LED_PIN, LOW);
    digitalWrite(DETECTION_LED_PIN, LOW);
    analogWrite(MOTOR_PWM_PIN, 0);
    centerAllServos();

    for (int i = 0; i < 3; i++) {
        digitalWrite(BUZZER_PIN, HIGH);
        delay(100);
        digitalWrite(BUZZER_PIN, LOW);
        delay(100);
    }

    Serial.println(F("*** EMERGENCY DISARM ***"));
}

void signalReady() {
    digitalWrite(BUZZER_PIN, HIGH);
    delay(200);
    digitalWrite(BUZZER_PIN, LOW);
}

void signalArmed() {
    for (int i = 0; i < 2; i++) {
        digitalWrite(BUZZER_PIN, HIGH);
        delay(150);
        digitalWrite(BUZZER_PIN, LOW);
        delay(150);
    }
}

void signalError(int beeps) {
    for (int i = 0; i < beeps; i++) {
        digitalWrite(BUZZER_PIN, HIGH);
        delay(500);
        digitalWrite(BUZZER_PIN, LOW);
        delay(300);
    }
}

