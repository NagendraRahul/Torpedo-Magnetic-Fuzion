    Serial.print(status.targetLocked ? F("LOCK") : F("SRCH"));
    Serial.print(F(" ERR="));
    Serial.println(status.errorCode);

    Serial.print(F("MAG: X="));
    Serial.print(magnetic.filteredX * 1e6, 2);
    Serial.print(F(" Y="));
    Serial.print(magnetic.filteredY * 1e6, 2);
    Serial.print(F(" Z="));
    Serial.print(magnetic.filteredZ * 1e6, 2);
    Serial.print(F(" |M|="));
    Serial.print(magnetic.signalStrength, 2);
    Serial.print(F("µT"));

    if (status.targetLocked) {
        Serial.print(F(" BEAR="));
        Serial.print(magnetic.bearing, 1);
